# Copy to .env.local. With nothing set, CareRide runs in demo mode (in-memory, fictional data).

# Supabase (create the project in Canada (Central), ca-central-1). Both set = Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL used in links inside emails and texts. Defaults to the request's host.
NEXT_PUBLIC_SITE_URL=

# Email via Resend. Without a key, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM="CareRide <careride@your-domain.org>"

# SMS via Twilio. Without these, texts are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
